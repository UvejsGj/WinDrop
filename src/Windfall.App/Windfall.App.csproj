<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Windfall.App</RootNamespace>
    <AssemblyName>Windfall</AssemblyName>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Product>Windfall</Product>
    <AssemblyTitle>Windfall</AssemblyTitle>
    <Company>Windfall</Company>
    <Version>0.1.0</Version>

    <!--
      Overrides Directory.Build.props. WPF data bindings resolve a culture when they
      activate, and with invariant globalization that lookup throws "Cannot find
      non-neutral culture related to en-us". The failure is delayed and confusing: the
      window opens fine and only dies once the first templated binding is realised,
      which here meant the moment a peer was discovered.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Windfall.Protocol\Windfall.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled at startup by Glass/ShaderCompiler.cs; the source is the only artefact. -->
    <EmbeddedResource Include="Glass\LiquidGlass.hlsl" LogicalName="Windfall.App.Glass.LiquidGlass.hlsl" />
  </ItemGroup>
</Project>
