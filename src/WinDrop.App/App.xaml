<Application x:Class="WinDrop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Apple's dark-mode system palette. These are colour values, not assets. -->
    <SolidColorBrush x:Key="Background" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Elevated" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Separator" Color="#38383A"/>
    <SolidColorBrush x:Key="Label" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryLabel" Color="#98989F"/>
    <SolidColorBrush x:Key="SystemBlue" Color="#0A84FF"/>
    <SolidColorBrush x:Key="SystemGreen" Color="#30D158"/>
    <SolidColorBrush x:Key="SystemRed" Color="#FF453A"/>

    <LinearGradientBrush x:Key="AvatarFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#5E5CE6" Offset="0"/>
      <GradientStop Color="#0A84FF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}" Padding="18,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
