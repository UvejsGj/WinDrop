<Application x:Class="WinDrop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDrop.App"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <local:CapsuleRadiusConverter x:Key="Capsule"/>

    <!--
      Monochrome. The glass carries the depth and the content carries the colour, so the
      chrome itself never reaches for a hue. Type does the ranking: Display for titles,
      Text for everything read at small sizes.
    -->

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="Label"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryLabel" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="TertiaryLabel"  Color="#61FFFFFF"/>
    <SolidColorBrush x:Key="Ink"            Color="#FF0A0A0B"/>

    <!-- The edge of a picture card: catches light at the top, loses it toward the bottom. -->
    <LinearGradientBrush x:Key="CardEdge" StartPoint="0,0" EndPoint="0.3,1">
      <GradientStop Color="#73FFFFFF" Offset="0"/>
      <GradientStop Color="#1AFFFFFF" Offset="0.45"/>
      <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!--
      Capsules. A press shrinks the button slightly and a release springs it back past
      its size before settling, which is most of what makes a control feel liquid rather
      than clicked. The scale lives on the template's own border, not on the Button: a
      transform set through a Style setter is shared and frozen, and cannot be animated.
    -->
    <Style x:Key="CapsuleButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}" Background="#F2F2F4"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.94" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.94" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TintedCapsuleButton" TargetType="Button" BasedOn="{StaticResource CapsuleButton}">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}" Background="#24FFFFFF"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#38FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.94" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.94" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toolbar glyphs, grouped inside a glass capsule. No fill until hovered. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3DFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
