<Window x:Class="WinDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinDrop.App"
        xmlns:glass="clr-namespace:WinDrop.App.Glass"
        Title="WinDrop" Width="440" Height="700"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="#050506"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnFilesDropped" DragOver="OnDragOver"
        DragEnter="OnDragEnter" DragLeave="OnDragLeave"
        MouseMove="OnPointerMoved">

  <!--
    Three layers, back to front:

      Scene      what the glass refracts: ambient light and the radar. Opaque, drawn by us.
      Interface  glass panes and text, positioned over the scene.
      Sheet      the consent prompt.

    The window is a fixed size, so the radar in the scene and the people floating above it
    share absolute coordinates rather than chasing each other through layout.
  -->

  <Window.Resources>
    <local:ProgressArcConverter x:Key="Arc"/>
    <local:BoolToVisibilityConverter x:Key="BoolVis"/>

    <ItemsPanelTemplate x:Key="OverlayPanel">
      <Grid/>
    </ItemsPanelTemplate>

    <!-- A file preview: pictures of contents are cards, artwork with its own shape stands alone. -->
    <DataTemplate x:Key="PreviewTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="{Binding Angle}"/>
            <TranslateTransform X="{Binding OffsetX}"/>
          </TransformGroup>
        </Grid.RenderTransform>

        <Rectangle Visibility="{Binding IsCard, Converter={StaticResource BoolVis}}"
                   RadiusX="{Binding Radius}" RadiusY="{Binding Radius}"
                   Stroke="{StaticResource CardEdge}" StrokeThickness="1"
                   RenderOptions.BitmapScalingMode="HighQuality">
          <Rectangle.Fill>
            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
          </Rectangle.Fill>
          <Rectangle.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
          </Rectangle.Effect>
        </Rectangle>

        <Image Source="{Binding Image}"
               Visibility="{Binding IsIcon, Converter={StaticResource BoolVis}}"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
    </DataTemplate>

    <!-- A person nearby: a glass bubble floating over the radar. -->
    <DataTemplate x:Key="PeerTile">
      <Grid Width="120" Cursor="Hand" Background="Transparent"
            RenderTransformOrigin="0.5,0.35" MouseLeftButtonUp="OnPeerClicked">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <StackPanel>
          <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <glass:GlassPanel Width="68" Height="68" CornerRadius="34" Frost="0.12" RimWidth="16">
              <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Label}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </glass:GlassPanel>

            <!-- Progress runs around the outside of the bubble, clockwise from twelve. -->
            <Path Stroke="{Binding RingBrush}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="84" Height="84" IsHitTestVisible="False"
                  Visibility="{Binding ShowRing, Converter={StaticResource BoolVis}}"
                  Data="{Binding Progress, Converter={StaticResource Arc}, ConverterParameter=84}"/>
          </Grid>

          <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Label}"
                     FontSize="13" FontWeight="Medium" TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="4,4,4,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryLabel}"
                     FontSize="11.5" TextAlignment="Center" Margin="0,1,0,0"/>
        </StackPanel>

        <Grid.Triggers>
          <!-- Arrive with a little spring, the way a new bubble appears in the share sheet. -->
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1" Duration="0:0:0.55">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.55">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
      </Grid>

      <DataTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.35">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.35">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4">
                  <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" glass:GlassPanel.Scene="{Binding ElementName=Scene}">

    <!-- ================================================================ Scene -->
    <Canvas x:Name="Scene" Width="440" Height="700" ClipToBounds="True"
            HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas.Background>
        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.95" RadiusY="0.72">
          <GradientStop Color="#FF1A1A1E" Offset="0"/>
          <GradientStop Color="#FF050506" Offset="1"/>
        </RadialGradientBrush>
      </Canvas.Background>

      <!-- Ambient light, drifting slowly so the glass always has something to bend. -->
      <Ellipse x:Name="AmbientA" Width="460" Height="460" Canvas.Left="-190" Canvas.Top="-150">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#3DFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="AmbientB" Width="520" Height="520" Canvas.Left="150" Canvas.Top="360">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#2BFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="AmbientC" Width="300" Height="300" Canvas.Left="210" Canvas.Top="60">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#1FFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- The radar: fixed rings for structure, pulses travelling outward from this device. -->
      <Ellipse Width="160" Height="160" Canvas.Left="140" Canvas.Top="220" Stroke="#1AFFFFFF" StrokeThickness="1"/>
      <Ellipse Width="300" Height="300" Canvas.Left="70"  Canvas.Top="150" Stroke="#14FFFFFF" StrokeThickness="1"/>
      <Ellipse Width="440" Height="440" Canvas.Left="0"   Canvas.Top="80"  Stroke="#0DFFFFFF" StrokeThickness="1"/>

      <Ellipse x:Name="PulseA" Width="440" Height="440" Canvas.Left="0" Canvas.Top="80"
               Stroke="#80FFFFFF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
      <Ellipse x:Name="PulseB" Width="440" Height="440" Canvas.Left="0" Canvas.Top="80"
               Stroke="#80FFFFFF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
      <Ellipse x:Name="PulseC" Width="440" Height="440" Canvas.Left="0" Canvas.Top="80"
               Stroke="#80FFFFFF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
    </Canvas>

    <!-- ============================================================ Interface -->

    <!-- Header: large title, and the window controls grouped in one glass capsule. -->
    <Grid x:Name="Header" Height="100" VerticalAlignment="Top" Background="Transparent"
          MouseLeftButtonDown="OnTitleBarDrag">
      <StackPanel Margin="26,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Text="WinDrop" FontFamily="{StaticResource DisplayFont}" FontSize="30"
                   FontWeight="SemiBold" Foreground="{StaticResource Label}"/>
        <TextBlock x:Name="DiscoverabilityText" Text="Starting…" FontSize="13"
                   Foreground="{StaticResource SecondaryLabel}" Margin="1,1,0,0"/>
      </StackPanel>

      <glass:GlassPanel Width="84" Height="42" CornerRadius="21" Margin="0,26,20,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Frost="0.18" RimWidth="12" Refraction="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"/>
        </StackPanel>
      </glass:GlassPanel>
    </Grid>

    <!-- Stage: this device at the centre of the radar, people floating around it. -->
    <Canvas x:Name="Stage" Width="440" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top">

      <StackPanel Canvas.Left="110" Canvas.Top="256" Width="220">
        <glass:GlassPanel Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"
                          Frost="0.1" RimWidth="20" Refraction="18">
          <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="32"
                     Foreground="{StaticResource Label}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </glass:GlassPanel>
        <TextBlock x:Name="LocalName" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Label}" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
        <TextBlock Text="This PC" FontSize="12" Foreground="{StaticResource SecondaryLabel}"
                   TextAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>

      <StackPanel x:Name="EmptyState" Canvas.Left="40" Canvas.Top="438" Width="360">
        <TextBlock Text="Looking for people nearby…" FontSize="14" FontWeight="Medium"
                   Foreground="{StaticResource SecondaryLabel}" TextAlignment="Center"/>
        <TextBlock Text="iPhones only appear over AWDL" FontSize="12"
                   Foreground="{StaticResource TertiaryLabel}" TextAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>

      <ItemsControl x:Name="PeerList" Width="440" Height="700" ItemTemplate="{StaticResource PeerTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </Canvas>

    <!-- Toast: transient status, instead of a permanent status bar nobody reads. -->
    <glass:GlassPanel x:Name="Toast" Height="40" CornerRadius="20" Padding="18,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,112,0,0"
                      Opacity="0" IsHitTestVisible="False" Frost="0.4" RimWidth="12" Refraction="10">
      <glass:GlassPanel.RenderTransform>
        <TranslateTransform x:Name="ToastSlide"/>
      </glass:GlassPanel.RenderTransform>
      <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                 Foreground="{StaticResource Label}" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
    </glass:GlassPanel>

    <!-- Tray: what is about to be sent. Floats; grows when files are dragged over the window. -->
    <glass:GlassPanel x:Name="Tray" Height="100" CornerRadius="32" Margin="16,0,16,16"
                      VerticalAlignment="Bottom" Padding="18,0,16,0"
                      RenderTransformOrigin="0.5,0.5" Frost="0.28">
      <glass:GlassPanel.RenderTransform>
        <ScaleTransform x:Name="TrayScale"/>
      </glass:GlassPanel.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Width="64" Height="64" VerticalAlignment="Center">
          <Border x:Name="TrayPlaceholder" CornerRadius="18" Background="#14FFFFFF"
                  BorderBrush="#24FFFFFF" BorderThickness="1">
            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="22"
                       Foreground="{StaticResource SecondaryLabel}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ItemsControl x:Name="PreviewStack"
                        ItemTemplate="{StaticResource PreviewTemplate}"
                        ItemsPanel="{StaticResource OverlayPanel}"
                        Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
          <TextBlock x:Name="FilesHeadline" Text="Drop files to share" FontSize="15.5"
                     FontWeight="SemiBold" Foreground="{StaticResource Label}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="FilesDetail" Text="or choose them from this PC" FontSize="12.5"
                     Foreground="{StaticResource SecondaryLabel}" Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button x:Name="ChooseButton" Grid.Column="2" Content="Choose"
                Style="{StaticResource CapsuleButton}" VerticalAlignment="Center"
                Click="OnChooseFiles"/>
      </Grid>
    </glass:GlassPanel>

    <!-- ================================================================ Sheet -->
    <Grid x:Name="ConsentSheet" Visibility="Collapsed">
      <Rectangle x:Name="ConsentScrim" Fill="#99000000"/>

      <glass:GlassPanel x:Name="ConsentCard" CornerRadius="36" Margin="12,0,12,12"
                        VerticalAlignment="Bottom" Padding="24,28,24,24"
                        Frost="0.5" BlurRadius="22" RimWidth="24" Refraction="20">
        <glass:GlassPanel.RenderTransform>
          <TranslateTransform x:Name="ConsentSlide"/>
        </glass:GlassPanel.RenderTransform>
        <StackPanel>
          <ItemsControl x:Name="ConsentPreview" Height="140" Margin="0,0,0,20"
                        ItemTemplate="{StaticResource PreviewTemplate}"
                        ItemsPanel="{StaticResource OverlayPanel}"
                        Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
          <TextBlock x:Name="ConsentTitle" FontFamily="{StaticResource DisplayFont}" FontSize="23"
                     FontWeight="SemiBold" Foreground="{StaticResource Label}"
                     TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="ConsentDetail" FontSize="14" Foreground="{StaticResource SecondaryLabel}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Grid Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Decline" Style="{StaticResource TintedCapsuleButton}" Height="50" Click="OnDecline"/>
            <Button Grid.Column="2" Content="Accept" Style="{StaticResource CapsuleButton}" Height="50" Click="OnAccept"/>
          </Grid>
        </StackPanel>
      </glass:GlassPanel>
    </Grid>

  </Grid>
</Window>
