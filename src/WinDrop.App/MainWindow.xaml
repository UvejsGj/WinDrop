<Window x:Class="WinDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinDrop.App"
        Title="WinDrop" Height="660" Width="500"
        WindowStyle="None"
        Background="#0A0A0A"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" Drop="OnFilesDropped" DragOver="OnDragOver">

  <!--
    No AllowsTransparency. It forces a layered window, which DWM will not composite an
    acrylic backdrop behind — and the backdrop is the entire point of the design. DWM
    rounds the corners instead. See WindowBackdrop.cs.
  -->

  <Window.Resources>
    <local:ProgressArcConverter x:Key="Arc"/>
    <local:BoolToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="PeerTile">
      <Grid Width="124" Margin="4,12" Cursor="Hand" Background="Transparent"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnPeerClicked">
        <Grid.RowDefinitions>
          <RowDefinition Height="96"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.RenderTransform>
          <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid Grid.Row="0" Width="96" Height="96">
          <!-- The disc: glass, with a specular edge rather than a flat outline. -->
          <Ellipse Width="76" Height="76" Fill="{StaticResource AvatarGlass}"/>
          <Ellipse x:Name="Rim" Width="76" Height="76" StrokeThickness="1"
                   Stroke="{StaticResource GlassEdge}"/>

          <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Label}"
                     FontSize="25" FontWeight="Light"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <!-- Progress sweeps outside the disc so it never fights the initials. -->
          <Path Stroke="{Binding RingBrush}" StrokeThickness="2.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="96" Height="96"
                Visibility="{Binding ShowRing, Converter={StaticResource BoolVis}}"
                Data="{Binding Progress, Converter={StaticResource Arc}, ConverterParameter=96}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Foreground="{StaticResource Label}"
                   FontSize="13" FontWeight="Normal" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TertiaryLabel}"
                   FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/>
      </Grid>

      <DataTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                 To="1.06" Duration="0:0:0.16"/>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                 To="1.06" Duration="0:0:0.16"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                 To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                 To="1" Duration="0:0:0.2"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Chrome. No system title bar, so this is also the drag handle. -->
    <Grid Grid.Row="0" Height="48" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
      <TextBlock Text="WinDrop" Foreground="{StaticResource Label}"
                 FontSize="13" FontWeight="SemiBold" Opacity="0.9"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Content="✕" Style="{StaticResource ChromeButton}"
              HorizontalAlignment="Right" Margin="0,0,12,0" Click="OnClose"/>
    </Grid>

    <!-- Drop target. Glass over the backdrop, with sheen laid on top. -->
    <Grid Grid.Row="1" Margin="20,2,20,16">
      <Border CornerRadius="16" Background="{StaticResource Glass}"
              BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"/>
      <Border CornerRadius="16" Background="{StaticResource GlassSheen}"/>
      <StackPanel Margin="20,22">
        <TextBlock x:Name="FilesHeadline" Text="Drop files here"
                   Foreground="{StaticResource Label}" FontSize="15" FontWeight="Light"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="FilesDetail" Text="folders welcome"
                   Foreground="{StaticResource TertiaryLabel}" FontSize="12"
                   TextAlignment="Center" Margin="0,5,0,0"/>
        <Button Content="Choose" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnChooseFiles"/>
      </StackPanel>
    </Grid>

    <!-- Peers -->
    <Grid Grid.Row="2" Margin="12,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerTile}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Looking for people nearby" Foreground="{StaticResource SecondaryLabel}"
                   FontSize="13" FontWeight="Light" TextAlignment="Center"/>
        <TextBlock Text="an iPhone will not appear — it needs AWDL"
                   Foreground="{StaticResource TertiaryLabel}"
                   FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="3" Padding="20,12" BorderBrush="{StaticResource HairlineSoft}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Text="Starting" Foreground="{StaticResource TertiaryLabel}"
                 FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- Consent. Scrims the whole window so the decision is unmissable. -->
    <Grid x:Name="ConsentSheet" Grid.RowSpan="4" Visibility="Collapsed">
      <Rectangle Fill="#B0000000"/>
      <Grid VerticalAlignment="Bottom" Margin="20,0,20,20">
        <Border CornerRadius="18" Background="#26FFFFFF"
                BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"/>
        <Border CornerRadius="18" Background="{StaticResource GlassSheen}"/>
        <StackPanel Margin="24">
          <TextBlock x:Name="ConsentTitle" Foreground="{StaticResource Label}" FontSize="16"
                     FontWeight="Light" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock x:Name="ConsentDetail" Foreground="{StaticResource SecondaryLabel}" FontSize="12"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Decline" Style="{StaticResource GlassButton}" Width="130"
                    Margin="0,0,10,0" Click="OnDecline"/>
            <Button Content="Accept" Style="{StaticResource PrimaryButton}" Width="130" Click="OnAccept"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

  </Grid>
</Window>
